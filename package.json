{
  "name": "lumensub-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Indexer, billing scheduler, merchant API and webhooks for LumenSub",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^5.2.6",
    "@stellar/stellar-sdk": "^13.3.0",
    "fastify": "^5.12.8",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.6",
    "typescript-eslint": "^8.74.0",
    "vitest": "^2.1.9"
  }
}
