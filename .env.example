# Copy to .env and adjust. Every value here has a default except the ones marked required.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Required
DATABASE_URL=postgres://lumensub:lumensub@127.0.0.1:5432/lumensub
# Optional. Used for shared rate limiting when you run more than one API instance.
# REDIS_URL=redis://127.0.0.1:6379

STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Required. The deployed subscription contract from lumensub-contracts.
SUBSCRIPTION_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
INDEXER_START_LEDGER=0
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_PAGE_SIZE=200

# The keeper submits charge() for subscriptions that are due. Leave it off unless
# you have funded a keeper account on the same network.
KEEPER_ENABLED=false
# KEEPER_SECRET=S...
KEEPER_INTERVAL_MS=15000
KEEPER_BATCH_SIZE=20

WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
